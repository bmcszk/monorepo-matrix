# Example environment file for testing the action locally
# Copy this file to .env and update with your test values

# GitHub Actions inputs
INPUT_BUILD_ALL=false
INPUT_MAP=pkg/** -> consumer|producer
services/consumer/** -> consumer
services/producer/** -> producer
INPUT_GITHUB_TOKEN=your-github-token-here

# GitHub context simulation
GITHUB_WORKFLOW_REF=main.yml@main
GITHUB_HEAD_REF=feature-branch
GITHUB_REF=refs/heads/main
GITHUB_EVENT_NAME=push
GITHUB_REPOSITORY=owner/repo
GITHUB_WORKSPACE=/tmp/workspace